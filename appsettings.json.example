..0{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://your-frontend-app.azurestaticapps.net"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=<YOUR_AZURE_POSTGRES_HOST>;Port=5432;Database=<YOUR_DATABASE>;Username=<YOUR_USERNAME>;Password=<YOUR_PASSWORD>;Ssl Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Issuer": "SeasonsCareApi",
    "Audience": "SeasonsCareClient",
    "SecretKey": "<YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS>"
  },
  "OpenAI": {
    "ApiKey": "<YOUR_OPENAI_API_KEY>",
    "Model": "gpt-4o-mini"
  }
}
